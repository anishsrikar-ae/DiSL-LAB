    %store/vec4 v0x55591add8160_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x55591add8160_0;
    %cmpi/s 0, 0, 32;
    %flag_inv 5; GE is !LT
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x55591ad8c7f0_0;
    %load/vec4 v0x55591add8160_0;
    %part/s 1;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x55591add8160_0;
    %parti/s 4, 0, 2;
    %store/vec4 v0x55591ad8cc00_0, 0, 4;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55591add8220_0, 0, 1;
T_0.2 ;
    %load/vec4 v0x55591add8160_0;
    %subi 1, 0, 32;
    %store/vec4 v0x55591add8160_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x55591adc5ae0;
T_1 ;
    %vpi_call 2 12 "$dumpfile", "question5.vcd" {0 0 0};
    %vpi_call 2 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55591adc5ae0 {0 0 0};
    %pushi/vec4 1, 0, 16;
