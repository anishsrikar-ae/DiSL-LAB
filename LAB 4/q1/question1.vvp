S_0x55996c3c50e0 .scope module, "question1_tb" "question1_tb" 2 4;
 .timescale -9 -9;
v0x55996c3d7060_0 .var "a", 0 0;
v0x55996c3d7120_0 .var "b", 0 0;
v0x55996c3d71f0_0 .net "carry", 0 0, L_0x55996c3d7520;  1 drivers
v0x55996c3d72f0_0 .net "sum", 0 0, L_0x55996c3d73c0;  1 drivers
S_0x55996c3c5270 .scope module, "q1" "question1" 2 11, 3 1 0, S_0x55996c3c50e0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
L_0x55996c3d73c0 .functor XOR 1, v0x55996c3d7060_0, v0x55996c3d7120_0, C4<0>, C4<0>;
v0x55996c38bcf0_0 .net "a", 0 0, v0x55996c3d7060_0;  1 drivers
v0x55996c3d6d60_0 .net "b", 0 0, v0x55996c3d7120_0;  1 drivers
v0x55996c3d6e20_0 .net "carry", 0 0, L_0x55996c3d7520;  alias, 1 drivers
v0x55996c3d6ef0_0 .net "sum", 0 0, L_0x55996c3d73c0;  alias, 1 drivers
L_0x55996c3d7520 .arith/mult 1, v0x55996c3d7060_0, v0x55996c3d7120_0;
    .scope S_0x55996c3c50e0;
T_0 ;
    %vpi_call 2 14 "$dumpfile", "question1.vcd" {0 0 0};
    %vpi_call 2 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55996c3c50e0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55996c3d7060_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55996c3d7120_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55996c3d7060_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55996c3d7120_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55996c3d7060_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55996c3d7120_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55996c3d7060_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55996c3d7120_0, 0, 1;
